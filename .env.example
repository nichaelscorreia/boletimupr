PORT=3000
ORACLE_SAFRA=54
# Data de início da safra (dd/mm/aaaa). Vazio = padrão configurado no Tomcat (INICIO_SAFRA_PADRAO)
SAFRA_INICIO=

# Boletim API (Tomcat na rede da usina) - os dados Oracle vêm daqui
BOLETIM_API_URL=http://nstech.ddns.net:8086/boletim-api
# Mesmo valor de API_SECRET em conf/Catalina/localhost/boletim-api.xml no Tomcat
BOLETIM_API_SECRET=
BOLETIM_API_TIMEOUT_MS=150000

# Controle de acesso por dispositivo ("off" desliga; ex.: desenvolvimento local sem Tomcat)
CONTROLE_ACESSO=on
# Código que libera o dispositivo na hora, já como ADMINISTRADOR (use no seu primeiro acesso).
# Guarde em segredo; vazio desativa a opção.
ACESSO_CODIGO_LIBERACAO=

# Defina FORCE_MOCK=true para forçar o gerador de dados mesmo se a API responder
FORCE_MOCK=false
